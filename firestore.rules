rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.uid == '6stDNIpNXGeROiN6tjCz4yBwIAe2';
    }

    function validAudit(data) {
      return data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.updatedBy is string;
    }

    function validAuditOnCreate(data) {
      return validAudit(data)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid;
    }

    function validAuditOnUpdate(data) {
      return validAudit(data)
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validStatus(data) {
      return data.keys().hasAny(['isActive', 'active'])
        && (!data.keys().hasAny(['isActive']) || data.isActive is bool)
        && (!data.keys().hasAny(['active']) || data.active is bool);
    }

    function validQuickCard(data, id) {
      return data.keys().hasOnly([
          'id', 'quickKey', 'title', 'description', 'icon', 'href', 'badge', 'size',
          'sortOrder', 'isActive', 'active', 'buttonText', 'url', 'category',
          'openInNewTab', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'quickKey', 'title', 'href'])
        && data.id == id
        && data.quickKey == id
        && data.id is string
        && data.quickKey is string
        && data.title is string
        && data.href is string
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['badge']) || data.badge is string)
        && (!data.keys().hasAny(['size']) || data.size is string)
        && (!data.keys().hasAny(['buttonText']) || data.buttonText is string)
        && (!data.keys().hasAny(['url']) || data.url is string)
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['openInNewTab']) || data.openInNewTab is bool)
        && validStatus(data)
        && validAudit(data);
    }

    function validForm(data, id) {
      return data.keys().hasOnly([
          'id', 'formKey', 'title', 'subtitle', 'description', 'icon', 'badge',
          'linkText', 'linkUrl', 'size', 'sortOrder', 'isActive', 'active',
          'buttonText', 'url', 'category', 'department', 'openInNewTab',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'formKey', 'title'])
        && data.id == id
        && data.formKey == id
        && data.id is string
        && data.formKey is string
        && data.title is string
        && (!data.keys().hasAny(['subtitle']) || data.subtitle is string)
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['badge']) || data.badge is string)
        && (!data.keys().hasAny(['linkText']) || data.linkText is string)
        && (!data.keys().hasAny(['linkUrl']) || data.linkUrl is string)
        && (!data.keys().hasAny(['size']) || data.size is string)
        && (!data.keys().hasAny(['buttonText']) || data.buttonText is string)
        && (!data.keys().hasAny(['url']) || data.url is string)
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['department']) || data.department is string)
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['openInNewTab']) || data.openInNewTab is bool)
        && validStatus(data)
        && validAudit(data);
    }

    function validService(data, id) {
      return data.keys().hasOnly([
          'id', 'serviceKey', 'title', 'subtitle', 'description', 'tag', 'icon',
          'linkText', 'linkUrl', 'size', 'sortOrder', 'isActive', 'active',
          'buttonText', 'url', 'category', 'openInNewTab',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'serviceKey', 'title'])
        && data.id == id
        && data.serviceKey == id
        && data.id is string
        && data.serviceKey is string
        && data.title is string
        && (!data.keys().hasAny(['subtitle']) || data.subtitle is string)
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['tag']) || data.tag is string)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['linkText']) || data.linkText is string)
        && (!data.keys().hasAny(['linkUrl']) || data.linkUrl is string)
        && (!data.keys().hasAny(['size']) || data.size is string)
        && (!data.keys().hasAny(['buttonText']) || data.buttonText is string)
        && (!data.keys().hasAny(['url']) || data.url is string)
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['openInNewTab']) || data.openInNewTab is bool)
        && validStatus(data)
        && validAudit(data);
    }

    function validPolicy(data, id) {
      return data.keys().hasOnly([
          'id', 'policyKey', 'title', 'description', 'fileUrl', 'icon', 'version',
          'updatedDate', 'publishDate', 'buttonText', 'category', 'order', 'sortOrder',
          'isActive', 'active', 'openInNewTab', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'policyKey', 'title'])
        && data.id == id
        && data.policyKey == id
        && data.id is string
        && data.policyKey is string
        && data.title is string
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['fileUrl']) || data.fileUrl is string)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['version']) || data.version is string)
        && (!data.keys().hasAny(['updatedDate']) || data.updatedDate is string)
        && (!data.keys().hasAny(['publishDate']) || data.publishDate is string)
        && (!data.keys().hasAny(['buttonText']) || data.buttonText is string)
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['order']) || data.order is number)
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['openInNewTab']) || data.openInNewTab is bool)
        && validStatus(data)
        && validAudit(data);
    }

    function validAdminCard(data, id) {
      return data.keys().hasOnly([
          'id', 'adminKey', 'title', 'description', 'tag', 'linkText', 'linkUrl',
          'size', 'sortOrder', 'isActive', 'active', 'buttonText', 'url', 'icon',
          'category', 'openInNewTab', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'adminKey', 'title'])
        && data.id == id
        && data.adminKey == id
        && data.id is string
        && data.adminKey is string
        && data.title is string
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['tag']) || data.tag is string)
        && (!data.keys().hasAny(['linkText']) || data.linkText is string)
        && (!data.keys().hasAny(['linkUrl']) || data.linkUrl is string)
        && (!data.keys().hasAny(['size']) || data.size is string)
        && (!data.keys().hasAny(['buttonText']) || data.buttonText is string)
        && (!data.keys().hasAny(['url']) || data.url is string)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['openInNewTab']) || data.openInNewTab is bool)
        && validStatus(data)
        && validAudit(data);
    }

    function validAnnouncement(data, id) {
      return data.keys().hasOnly([
          'id', 'title', 'body', 'tag', 'date', 'endDate', 'linkText', 'linkUrl',
          'priority', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasAll(['id', 'title', 'body', 'tag', 'date', 'endDate', 'linkText', 'linkUrl', 'priority', 'isActive'])
        && data.id == id
        && data.id is string
        && data.title is string
        && data.body is string
        && data.tag is string
        && data.date is string
        && data.endDate is string
        && data.linkText is string
        && data.linkUrl is string
        && data.priority is number
        && data.isActive is bool
        && validAudit(data);
    }

    function validContact(data) {
      return data.keys().hasOnly(['email', 'phone', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasAll(['email', 'phone', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.email is string
        && data.email.size() > 0
        && data.phone is string
        && data.phone.size() > 0
        && validAudit(data);
    }

    match /announcements/{id} {
      allow read: if true;
      allow create: if admin() && validAnnouncement(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validAnnouncement(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /quickCards/{id} {
      allow read: if true;
      allow create: if admin() && validQuickCard(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validQuickCard(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /forms/{id} {
      allow read: if true;
      allow create: if admin() && validForm(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validForm(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /services/{id} {
      allow read: if true;
      allow create: if admin() && validService(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validService(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /policies/{id} {
      allow read: if true;
      allow create: if admin() && validPolicy(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validPolicy(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /adminCards/{id} {
      allow read: if true;
      allow create: if admin() && validAdminCard(request.resource.data, id) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validAdminCard(request.resource.data, id) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }

    match /settings/contact {
      allow read: if true;
      allow create: if admin() && validContact(request.resource.data) && validAuditOnCreate(request.resource.data);
      allow update: if admin() && validContact(request.resource.data) && validAuditOnUpdate(request.resource.data);
      allow delete: if admin();
    }
  }
}
